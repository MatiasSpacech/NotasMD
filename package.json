{
  "name": "notas-app",
  "version": "0.1.0",
  "private": true,
  "description": "Aplicación de notas Markdown con referencias cruzadas, historial de versiones y autocompletado",
  "scripts": {
    "dev": "vite --config src/frontend/vite.config.ts",
    "dev:server": "tsx src/backend/server.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "build": "tsc && vite build --config src/frontend/vite.config.ts",
    "preview": "vite preview --config src/frontend/vite.config.ts",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@uiw/react-md-editor": "^3.25.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "glob": "^10.3.10",
    "jszip": "^3.10.2",
    "lucide-react": "^0.294.0",
    "prettier": "^3.9.10",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "unpdf": "^1.8.1",
    "uuid": "^9.0.0",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "eslint": "^8.55.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.8"
  }
}
